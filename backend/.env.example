# Server and database
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated browser origins permitted to call the API.
# Vite's default local development origin is included below.
FRONTEND_ORIGIN=http://localhost:5173

# FastAPI attrition prediction service. The Express API is the only caller.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=8000

# Local retrieval-only HR knowledge service.
HR_KNOWLEDGE_URL=http://127.0.0.1:8100
HR_KNOWLEDGE_TIMEOUT_MS=8000

# Grounded HR Copilot LLM. Groq is the default OpenAI-compatible provider.
LLM_PROVIDER=groq
GROQ_API_KEY=
# LLM_API_KEY= # Use instead of GROQ_API_KEY for another OpenAI-compatible provider.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_MS=15000
LLM_MAX_TOKENS=700
COPILOT_HISTORY_LIMIT=8
COPILOT_RETRIEVAL_TOP_K=5
COPILOT_MIN_CONFIDENCE=0.35

# Evidence-grounded Manager Coaching Agent.
MANAGER_COACH_POLICY_TOP_K=4
MANAGER_COACH_POLICY_MIN_SCORE=0.35
